#!/usr/bin/env bash
# nice-dns: one command for the stack on Linux and macOS. It picks the install
# script for this platform and adds no install logic (lib/install.sh holds it).
# Written for macOS's Bash 3.2. No `set -e`: the libraries `restart` sources run
# under the controller's options (health/nice-dns-health), and every step here
# checks its own result.
set -uo pipefail

ND_CLI_SNAPSHOT="$HOME/.local/share/nice-dns/source"
# shellcheck disable=SC2016  # the backticks are text for the reader
ND_CLI_NOT_INSTALLED='nice-dns is not installed; run `nice-dns install`'
ND_CLI_REPO=https://github.com/sureserverman/nice-dns.git

usage() {
  cat <<'EOF'
Usage: nice-dns <command> [options]

  install [haproxy|socat] [--hardened] [--branch B]
      Install the stack (defaults: haproxy, standard Pi-hole, main).
  reinstall [haproxy|socat] [--hardened|--standard] [--branch B] [--local]
      Install again with the recorded choices; options override them.
      A checkout uses itself. The installed command clones the branch;
      --local uses the source kept at the last install instead.
  restart
      Restart the whole stack and wait for DNS to answer.
  update --check [--branch B]
      Ask the recorded branch (or B) for its newest commit and compare it
      with the installed one: prints `current` (exit 0), `available <commit>`
      (exit 10) or `unknown: <reason>` (exit 1). Keeps the answer for
      `status`. Changes nothing else.
  status [--tsv]
      What is installed, what the controller last saw and did, and the
      last update check. Reads files only. --tsv prints the
      nice-dns-status/1 rows (docs/cli-contract.md). Exit 0, 1 when
      nothing is installed, 2 when the controller's state is unreadable.
  uninstall
      Remove the stack, then this command.
EOF
}

bad_usage() {
  printf 'nice-dns: %s\n' "$1" >&2
  usage >&2
  exit 2
}

err() { printf 'nice-dns: %s\n' "$1" >&2; }

if [ "$(id -u)" -eq 0 ]; then
  echo "Please run nice-dns as a regular user, not with sudo." >&2
  exit 1
fi

[ $# -gt 0 ] || bad_usage "no command given"
ND_CLI_CMD="$1"
shift

case "$ND_CLI_CMD" in
  install|reinstall|restart|uninstall|status|update) ;;
  -h|--help|help) usage; exit 0 ;;
  *) bad_usage "unknown command '$ND_CLI_CMD'" ;;
esac

case "$(uname -s)" in
  Linux) ND_CLI_PLATFORM=linux ND_CLI_OS=deb ;;
  Darwin) ND_CLI_PLATFORM=macos ND_CLI_OS=mac ;;
  *) err "unsupported platform '$(uname -s)'; nice-dns runs on Linux and macOS"; exit 1 ;;
esac

ND_CLI_HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$ND_CLI_HERE/lib/install.sh" ]; then
  ND_CLI_CHECKOUT=1 ND_CLI_ROOT="$ND_CLI_HERE"
else
  ND_CLI_CHECKOUT=0 ND_CLI_ROOT="$ND_CLI_SNAPSHOT"
fi

# Same place as lib/install.sh nd_install_state_dir. Read here too, because
# "nothing is installed" must be answerable with no source tree at all.
state_dir() {
  case "$ND_CLI_PLATFORM" in
    linux) printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/nice-dns-install" ;;
    macos) printf '%s\n' "$HOME/Library/Application Support/nice-dns-install" ;;
  esac
}

# recorded_manifest: the current generation's prepare.tsv; 1 when none.
recorded_manifest() {
  local sd gen
  sd="$(state_dir)"
  [ -f "$sd/current" ] || return 1
  gen="$(cat "$sd/current")"
  [ -n "$gen" ] && [ -f "$sd/generations/$gen/prepare.tsv" ] || return 1
  printf '%s\n' "$sd/generations/$gen/prepare.tsv"
}

recorded_field() { awk -F '\t' -v k="$2" '$1 == k { print $2; exit }' "$1"; }

ND_CLI_VARIANT="" ND_CLI_PIHOLE="" ND_CLI_BRANCH="" ND_CLI_LOCAL=0

# parse_choices <allow reinstall-only options: 0|1> <args...>
parse_choices() {
  local re="$1"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      haproxy|socat)
        [ -z "$ND_CLI_VARIANT" ] || bad_usage "more than one proxy variant given"
        ND_CLI_VARIANT="$1" ;;
      --hardened) ND_CLI_PIHOLE=hardened ;;
      --standard)
        [ "$re" = 1 ] || bad_usage "unknown option '$1' for $ND_CLI_CMD"
        ND_CLI_PIHOLE=standard ;;
      --local)
        [ "$re" = 1 ] || bad_usage "unknown option '$1' for $ND_CLI_CMD"
        ND_CLI_LOCAL=1 ;;
      --branch)
        [ $# -ge 2 ] || bad_usage "--branch needs a name"
        case "$2" in -*|'') bad_usage "--branch needs a name" ;; esac
        ND_CLI_BRANCH="$2"
        shift ;;
      *) bad_usage "unknown option '$1' for $ND_CLI_CMD" ;;
    esac
    shift
  done
}

# hardened_sibling: the pi-hole-hardened checkout for an install run from
# anywhere but a checkout, whose own parent directory holds nothing useful: the
# checkout's neighbour, else the one the last hardened install recorded, else a
# stable place the installer's refusal can name.
hardened_sibling() {
  local m row
  if [ "$ND_CLI_CHECKOUT" = 1 ]; then
    printf '%s\n' "$(cd "$ND_CLI_HERE/.." && pwd)/pi-hole-hardened"
    return 0
  fi
  if m="$(recorded_manifest)"; then
    row="$(awk -F '\t' '$1 == "source" && $2 == "hardened-base" { print $3; exit }' "$m")"
    row="${row%@*}"
    if [ -n "$row" ] && [ -f "$row/Dockerfile" ]; then
      printf '%s\n' "$row"
      return 0
    fi
  fi
  printf '%s\n' "$HOME/.local/share/nice-dns/pi-hole-hardened"
}

# run_installer <source root> <variant> <flavour> <branch>
run_installer() {
  local script="install-$ND_CLI_OS"
  [ "$3" = hardened ] && script="$script-hardened"
  if [ "$3" = hardened ] && { [ "$ND_CLI_CHECKOUT" = 0 ] || [ "$1" != "$ND_CLI_HERE" ]; }; then
    ND_INST_HARDENED_SIBLING="$(hardened_sibling)"
    export ND_INST_HARDENED_SIBLING
  fi
  script="$1/$script.sh"
  if [ ! -f "$script" ]; then
    err "no installer at $script"
    return 1
  fi
  bash "$script" "$2" "$4"
}

ND_CLI_TMP=""
cleanup_tmp() { [ -z "$ND_CLI_TMP" ] || rm -rf "${ND_CLI_TMP:?}"; }

# fetch_branch <branch>: clones it into a temporary directory, sets ND_CLI_SRC.
# An install script ignores its branch argument when it sits in a checkout, so
# a branch the operator named is only honoured from a clone. The running stack
# is what answers DNS here, so a stalled transfer must end by itself. Nothing
# has changed yet when this fails.
fetch_branch() {
  ND_CLI_TMP="$(mktemp -d "${TMPDIR:-/tmp}/nice-dns-fetch.XXXXXXXX")" || return 1
  trap cleanup_tmp EXIT
  if ! git -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 clone -q --depth 1 -b "$1" "$ND_CLI_REPO" "$ND_CLI_TMP/nice-dns"; then
    err "could not fetch branch '$1' (is DNS down?). The running stack is untouched."
    return 1
  fi
  ND_CLI_SRC="$ND_CLI_TMP/nice-dns"
}

# default_branch: what a run with no --branch records. A checkout's own branch;
# from the kept source, the branch last recorded.
default_branch() {
  local b="" m
  if [ "$ND_CLI_CHECKOUT" = 1 ]; then
    b="$(git -C "$ND_CLI_HERE" rev-parse --abbrev-ref HEAD 2>/dev/null)" || b=""
    [ "$b" != HEAD ] || b=""
  elif m="$(recorded_manifest)"; then
    b="$(recorded_field "$m" branch)"
  fi
  printf '%s\n' "${b:-main}"
}

cmd_install() {
  local src="$ND_CLI_ROOT" branch
  parse_choices 0 "$@"
  if [ -n "$ND_CLI_BRANCH" ]; then
    fetch_branch "$ND_CLI_BRANCH" || return 1
    src="$ND_CLI_SRC" branch="$ND_CLI_BRANCH"
  else
    if [ ! -f "$ND_CLI_ROOT/lib/install.sh" ]; then
      err "no source tree: run this from a checkout, or install with the curl command in the README"
      return 1
    fi
    branch="$(default_branch)"
  fi
  run_installer "$src" "${ND_CLI_VARIANT:-haproxy}" "${ND_CLI_PIHOLE:-standard}" "$branch"
}

cmd_uninstall() {
  [ $# -eq 0 ] || bad_usage "unknown option '$1' for uninstall"
  local script="$ND_CLI_ROOT/install-$ND_CLI_OS.sh"
  if [ ! -f "$script" ]; then
    err "$ND_CLI_NOT_INSTALLED"
    return 1
  fi
  bash "$script" uninstall
}

cmd_reinstall() {
  local m variant flavour branch src
  parse_choices 1 "$@"
  if ! m="$(recorded_manifest)"; then
    err "$ND_CLI_NOT_INSTALLED"
    return 1
  fi
  variant="${ND_CLI_VARIANT:-$(recorded_field "$m" variant)}"
  flavour="${ND_CLI_PIHOLE:-$(recorded_field "$m" pihole)}"
  branch="${ND_CLI_BRANCH:-$(recorded_field "$m" branch)}"
  case "$variant" in haproxy|socat) ;; *) err "the record $m names no proxy variant; give haproxy or socat"; return 1 ;; esac
  case "$flavour" in standard|hardened) ;; *) err "the record $m names no Pi-hole flavour; give --hardened or --standard"; return 1 ;; esac
  [ -n "$branch" ] || branch=main
  if [ "$ND_CLI_LOCAL" = 1 ] && [ -n "$ND_CLI_BRANCH" ]; then
    bad_usage "--local uses the kept source, so --branch has no meaning with it"
  fi

  if [ "$ND_CLI_LOCAL" = 1 ]; then
    src="$ND_CLI_SNAPSHOT"
    if [ ! -f "$src/lib/install.sh" ]; then
      err "no kept source at $src"
      return 1
    fi
  elif [ "$ND_CLI_CHECKOUT" = 1 ] && [ -z "$ND_CLI_BRANCH" ]; then
    src="$ND_CLI_HERE"
  else
    if ! fetch_branch "$branch"; then
      # shellcheck disable=SC2016  # the backticks are text for the reader
      err 'Run `nice-dns reinstall --local` to use the source kept at the last install.'
      return 1
    fi
    src="$ND_CLI_SRC"
  fi
  run_installer "$src" "$variant" "$flavour" "$branch"
}

# ─── restart ─────────────────────────────────────────────────────────────────

ND_CLI_LOCK="" ND_CLI_RELEASE=0

restart_cleanup() {
  [ -z "$ND_CLI_LOCK" ] || nd_state_unlock "$ND_CLI_LOCK" >/dev/null 2>&1
  ND_CLI_LOCK=""
  if [ "$ND_CLI_RELEASE" = 1 ]; then
    ND_CLI_RELEASE=0
    _nd_inst_release_controller
  fi
  cleanup_tmp
}

# restart_take_lock: stopping a timer does not end a pass already running, so
# wait for the controller's state lock (its lease is 600 s). A state directory
# that does not exist yet has no controller to overlap with.
restart_take_lock() {
  local i=0 rc max="${ND_CLI_LOCK_TRIES:-125}"
  while :; do
    ND_CLI_LOCK="$(nd_state_lock 2>/dev/null)"; rc=$?
    case "$rc" in
      0) return 0 ;;
      3) ;;
      *) ND_CLI_LOCK=""; return 0 ;;
    esac
    ND_CLI_LOCK=""
    i=$((i + 1))
    [ "$i" -lt "$max" ] || return 1
    sleep 5
  done
}

cmd_restart() {
  [ $# -eq 0 ] || bad_usage "unknown option '$1' for restart"
  local rc=0
  if ! recorded_manifest >/dev/null || [ ! -f "$ND_CLI_ROOT/lib/install.sh" ]; then
    err "$ND_CLI_NOT_INSTALLED"
    return 1
  fi
  ND_PLATFORM="$ND_CLI_PLATFORM"
  export ND_PLATFORM
  # shellcheck disable=SC1091  # the source root is found at run time
  . "$ND_CLI_ROOT/lib/install.sh" || return 1
  # shellcheck disable=SC1091
  . "$ND_CLI_ROOT/lib/recovery.sh" || return 1
  # shellcheck disable=SC2034  # read by the sourced lib/install.sh
  ND_INST_PLATFORM="$ND_CLI_PLATFORM"
  # shellcheck disable=SC2034
  ND_INST_SRC="$ND_CLI_ROOT"
  # shellcheck disable=SC2034
  ND_INST_TREE="$ND_CLI_ROOT"
  ND_CLI_TMP="$(mktemp -d "${TMPDIR:-/tmp}/nice-dns-restart.XXXXXXXX")" || return 1
  trap restart_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # Before the hold: a signal during it must still release what it stopped.
  # shellcheck disable=SC2034  # read by the sourced lib/install.sh
  ND_INST_HELD=""
  ND_CLI_RELEASE=1
  nd_install_hold_controller
  if ! restart_take_lock; then
    err "the controller is still busy; nothing was restarted. Try again in a few minutes."
    return 1
  fi
  echo "Restarting the stack..."
  nd_platform_restart_stack "${ND_RECOVERY_SERVICE_S:-120}" "$ND_CLI_TMP" || rc=$?
  if [ "$rc" -ne 0 ]; then
    err "the stack restart failed (exit $rc): $(head -n 1 "$ND_CLI_TMP/svc.err" 2>/dev/null)"
    # shellcheck disable=SC2016  # the backticks are text for the reader
    err 'Check `nice-dns-health status`.'
    return 1
  fi
  # The schedules stay held until exit, so the lock has done its work; a long
  # readiness wait must not outlast its 600 s lease.
  nd_state_unlock "$ND_CLI_LOCK" >/dev/null 2>&1
  ND_CLI_LOCK=""
  # The readiness check below must see the new stack, not the old one.
  nd_platform_wait_restarted "${ND_CLI_REBUILD_S:-300}" || rc=$?
  if [ "$rc" -ne 0 ] || ! nd_install_wait_ready 2>/dev/null; then
    # shellcheck disable=SC2016  # the backticks are text for the reader
    err 'the stack restarted, but DNS is not answering yet. Check `nice-dns-health status`.'
    return 1
  fi
  echo "nice-dns restarted; DNS is answering."
}

# ─── update ──────────────────────────────────────────────────────────────────

# update_cache_dir: the controller's state directory, where `status` reads the
# cache (lib/status.sh _nd_st_paths). 1 without the status library.
update_cache_dir() {
  local lib="$ND_CLI_ROOT/lib/status.sh"
  [ -f "$lib" ] || return 1
  # shellcheck disable=SC1090  # the source root is found at run time
  . "$lib" || return 1
  _nd_st_paths "$ND_CLI_PLATFORM"
  printf '%s\n' "$ND_ST_STATE_DIR"
}

# update_write_cache <branch> <local> <remote> <result>: update-check.tsv
# (nice-dns-update-check/1), renamed over from a temporary file. A failure
# to write it is reported and does not change the answer.
update_write_cache() {
  local d t
  if ! d="$(update_cache_dir)"; then err "the update check was not kept: no status library"; return 0; fi
  if { [ -d "$d" ] || (umask 077 && mkdir -p "$d"); } && t="$(mktemp "$d/.update-check.XXXXXX")"; then
    if printf 'schema\tnice-dns-update-check/1\nchecked_at\t%s\nbranch\t%s\nlocal_commit\t%s\nremote_commit\t%s\nresult\t%s\n' \
        "$(date +%s)" "$1" "$2" "${3:--}" "$4" >"$t" && chmod 600 "$t" && mv -f "$t" "$d/update-check.tsv"; then
      return 0
    fi
    rm -f "$t"
  fi
  err "the update check was not kept in ${d:-the state directory}"
  return 0
}

# update_check: sets ND_CLI_UP_RESULT (current|available|unknown),
# ND_CLI_UP_REMOTE, ND_CLI_UP_BRANCH and ND_CLI_UP_REASON, writes the
# cache and prints the answer. Returns 0, 10 or 1. Only `git ls-remote`
# reaches the network, bounded by its low-speed limit and, where it exists,
# by timeout(1).
update_check() {
  local m local_c dirty out to=""
  ND_CLI_UP_RESULT=unknown ND_CLI_UP_REMOTE="" ND_CLI_UP_REASON=""
  if ! m="$(recorded_manifest)"; then
    err "$ND_CLI_NOT_INSTALLED"
    return 1
  fi
  ND_CLI_UP_BRANCH="${ND_CLI_BRANCH:-$(recorded_field "$m" branch)}"
  [ -n "$ND_CLI_UP_BRANCH" ] || ND_CLI_UP_BRANCH=main
  local_c="$(recorded_field "$m" source_commit)"
  dirty="$(recorded_field "$m" source_dirty)"
  case "$local_c" in
    *[!0-9a-f]*|'') ND_CLI_UP_REASON="the installed source was not a clean commit" ;;
    *) [ "${#local_c}" -eq 40 ] && [ "$dirty" = 0 ] || ND_CLI_UP_REASON="the installed source was not a clean commit" ;;
  esac
  if [ -z "$ND_CLI_UP_REASON" ]; then
    command -v timeout >/dev/null 2>&1 && to="timeout 90"
    # shellcheck disable=SC2086  # $to is "timeout 90" or empty
    if ! out="$($to git -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 ls-remote --heads "$ND_CLI_REPO" "refs/heads/$ND_CLI_UP_BRANCH" 2>/dev/null)"; then
      ND_CLI_UP_REASON="could not reach $ND_CLI_REPO (is DNS down?)"
    else
      ND_CLI_UP_REMOTE="$(printf '%s\n' "$out" | awk -F '\t' -v r="refs/heads/$ND_CLI_UP_BRANCH" '$2 == r && $1 ~ /^[0-9a-f]+$/ && length($1) == 40 { print $1; exit }')"
      if [ -z "$ND_CLI_UP_REMOTE" ]; then
        ND_CLI_UP_REASON="the remote has no branch '$ND_CLI_UP_BRANCH'"
      elif [ "$ND_CLI_UP_REMOTE" = "$local_c" ]; then
        ND_CLI_UP_RESULT=current
      else
        ND_CLI_UP_RESULT=available
      fi
    fi
  fi
  update_write_cache "$ND_CLI_UP_BRANCH" "${local_c:--}" "$ND_CLI_UP_REMOTE" "$ND_CLI_UP_RESULT"
  case "$ND_CLI_UP_RESULT" in
    current) echo current; return 0 ;;
    available) printf 'available %s\n' "$(printf '%s' "$ND_CLI_UP_REMOTE" | cut -c1-12)"; return 10 ;;
  esac
  printf 'unknown: %s\n' "$ND_CLI_UP_REASON"
  return 1
}

# cmd_update --check [--branch B]
cmd_update() {
  local check=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1 ;;
      --branch)
        [ $# -ge 2 ] || bad_usage "--branch needs a name"
        case "$2" in -*|'') bad_usage "--branch needs a name" ;; esac
        ND_CLI_BRANCH="$2"
        shift ;;
      *) bad_usage "unknown option '$1' for update" ;;
    esac
    shift
  done
  [ "$check" = 1 ] || bad_usage "update needs --check"
  update_check
}

# ─── status ──────────────────────────────────────────────────────────────────

# status_human: the rows (stdin) as sections. Observations from a stale pass
# are printed under a header that says how old they are.
status_human() {
  awk -F '\t' '
    function sec(t) { if (shown++) print ""; print t }
    $1 == "schema" { next }
    $1 == "obs" { if ($2 ~ /^container:/) c[++nc] = $0; else if ($2 ~ /^route:/) r[++nr] = $0; else o[++no] = $0; next }
    { g[++ng] = $0 }
    $1 == "controller" && $2 == "stale" && $3 != "no" { stale = ($3 == "never") ? " (stale: no pass recorded)" : ($3 == "future") ? " (stale: the last pass is dated in the future)" : " (stale: last pass " $3 " s ago)" }
    $1 == "route" && $2 == "selected" { sel = $3 " (generation " $4 ")" }
    function kv(grp,   i, f, n, v) {
      for (i = 1; i <= ng; i++) { n = split(g[i], f, "\t"); if (f[1] != grp) continue
        v = f[3]; for (j = 4; j <= n; j++) v = v " " f[j]; printf "  %-15s %s\n", f[2], v }
    }
    function obs(a, n, strip,   i, f) { for (i = 1; i <= n; i++) { split(a[i], f, "\t"); sub(strip, "", f[2]); printf "  %-22s %-13s %s\n", f[2], f[3], f[5] } }
    END {
      sec("Install"); kv("install")
      sec("Controller"); kv("controller"); for (i = 1; i <= no; i++) { split(o[i], f, "\t"); printf "  check %-22s %-13s %s\n", f[2], f[3], f[5] }
      sec("Containers" stale); if (nc) obs(c, nc, "^container:"); else print "  (none observed)"
      sec("Routes" stale); if (sel != "") printf "  %-22s %s\n", "selected", sel; obs(r, nr, "^route:")
      sec("Bridges"); kv("bridges")
      sec("Update"); kv("update")
      sec("Admin"); kv("admin")
      sec("Recent actions")
      n = 0; for (i = 1; i <= ng; i++) { split(g[i], f, "\t"); if (f[1] == "recent") { printf "  %s  %-26s %s\n", f[2], f[3], f[4]; n++ } }
      if (!n) print "  (none)"
    }'
}

# status_hint: the README's install line for this platform, the hint a
# `status` with nothing installed adds after `install installed no`.
status_hint() {
  printf 'install\thint\tcurl -fsSL https://raw.githubusercontent.com/sureserverman/nice-dns/main/install-%s.sh -o install-%s.sh && bash install-%s.sh\n' \
    "$ND_CLI_OS" "$ND_CLI_OS" "$ND_CLI_OS"
}

# cmd_status [--tsv]: lib/status.sh from this checkout or the kept source.
cmd_status() {
  local tsv=0 rows rc lib="$ND_CLI_ROOT/lib/status.sh"
  while [ $# -gt 0 ]; do
    case "$1" in --tsv) tsv=1 ;; *) bad_usage "unknown option '$1' for status" ;; esac
    shift
  done
  if [ ! -f "$lib" ]; then
    if ! recorded_manifest >/dev/null; then
      printf 'schema\tnice-dns-status/1\ninstall\tinstalled\tno\n'
      status_hint
      err "$ND_CLI_NOT_INSTALLED"
      return 1
    fi
    err "no status library at $lib; reinstall to update the kept source"
    return 2
  fi
  # shellcheck disable=SC1090  # the source root is found at run time
  . "$lib" || return 2
  rows="$(nd_status_rows "$ND_CLI_PLATFORM")"; rc=$?
  if printf '%s\n' "$rows" | awk '$0 == "install\tinstalled\tno" { f = 1 } END { exit !f }'; then
    rows="$(printf '%s\n' "$rows" | awk -v h="$(status_hint)" '{ print } $0 == "install\tinstalled\tno" { print h }')"
  fi
  if [ "$tsv" = 1 ]; then printf '%s\n' "$rows"; else printf '%s\n' "$rows" | status_human; fi
  return "$rc"
}

case "$ND_CLI_CMD" in
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  reinstall) cmd_reinstall "$@" ;;
  restart) cmd_restart "$@" ;;
  status) cmd_status "$@" ;;
  update) cmd_update "$@" ;;
esac
