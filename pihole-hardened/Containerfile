# Hardened-base downstream of nice-dns/pihole.
#
# Use the sibling installer (install-deb-hardened.sh / install-mac-hardened.sh)
# which builds this with the repo root as the build context — that lets us
# reuse pihole/etc/, pihole/adlists-default.txt, and pihole/custom-allowlist.txt
# without duplicating them.
#
# Build command (matches what the installers run):
#   podman build -t pi-hole -f pihole-hardened/Containerfile .
#
# The base image localhost/pi-hole-hardened-base:latest is built first by the
# installer from the sibling pi-hole-hardened repo (or pulled from Docker Hub
# once published). It already runs pihole-FTL as uid 1000 with
# CAP_NET_BIND_SERVICE, ships the v6 admin web UI, and pre-seeds
# /etc/pihole/versions for the pinned upstream tags.
# Podman names the locally built base localhost/...; Apple's builder resolves
# a local image only by its plain name, so install-mac-hardened.sh passes
# --build-arg BASE_IMAGE=pi-hole-hardened-base:latest.
ARG BASE_IMAGE=localhost/pi-hole-hardened-base:latest
FROM ${BASE_IMAGE}

USER root

# --- Layer the nice-dns Pi-hole config on top of the hardened base ---
# pihole.toml supplies the upstreams/listening/privacy tweaks that the
# legacy upstream-based image had; the other etc/ files (dnsmasq.conf,
# logrotate, adlists.list, ...) are managed by pihole-FTL and get
# rewritten on first boot to match v6.6.1's schema.
#
# Save the base's pre-seeded /etc/pihole/versions before the COPY so we
# can restore it afterwards — pihole/etc/versions in the legacy nice-dns
# tree was hand-authored for the v6.1 upstream image and would otherwise
# clobber the hardened base's pin (v6.4.2/v6.5/v6.6.1), making
# `pihole -v` report stale versions even though the running FTL is v6.6.1.
RUN cp /etc/pihole/versions /tmp/pihole-base-versions
COPY --chown=pihole:pihole pihole/etc/. /etc/pihole/
RUN install -m 600 -o pihole -g pihole /tmp/pihole-base-versions /etc/pihole/versions \
    && rm /tmp/pihole-base-versions

# --- Build gravity.db at IMAGE BUILD TIME from the URL list ---
# Same pattern as the legacy Containerfile: blocklist downloads land here
# (where the host's /etc/resolv.conf during build provides working DNS)
# rather than at first-container-start (where rootless aardvark-DNS is
# unreachable from inside the container).
COPY --chown=pihole:pihole pihole/adlists-default.txt /tmp/adlists.txt
COPY --chown=pihole:pihole pihole/custom-allowlist.txt /tmp/allowlist.txt
# gravity.db lives on the lists volume, /var/lib/nice-dns-pihole
# (pihole.toml files.gravity; Sub-plan 4 Task 2.2), kept as this image's seed
# too, with its id, for nd-start.sh. chown still exists until post-install.sh.
RUN set -e; \
    mkdir -p /var/lib/nice-dns-pihole /usr/share/nice-dns/pihole; \
    chown pihole:pihole /var/lib/nice-dns-pihole; chmod 700 /var/lib/nice-dns-pihole; \
    grep -vE '^[[:space:]]*(#|$)' /tmp/adlists.txt > /etc/pihole/adlists.list; \
    chown pihole:pihole /etc/pihole/adlists.list; \
    pihole -g; \
    grep -vE '^[[:space:]]*(#|$)' /tmp/allowlist.txt | while IFS= read -r d; do \
      pihole-FTL sqlite3 -ni /var/lib/nice-dns-pihole/gravity.db \
        "INSERT OR IGNORE INTO domainlist (type, domain, enabled, comment) \
         VALUES (0, '$d', 1, 'Seeded at image build time (allowlist)');"; \
    done; \
    rm /tmp/adlists.txt /tmp/allowlist.txt; \
    cp /var/lib/nice-dns-pihole/gravity.db /usr/share/nice-dns/pihole/gravity.seed.db; \
    sha256sum /usr/share/nice-dns/pihole/gravity.seed.db | cut -c1-64 >/usr/share/nice-dns/pihole/seed-id; \
    cp /usr/share/nice-dns/pihole/seed-id /var/lib/nice-dns-pihole/seed-id; \
    chown -R pihole:pihole /var/lib/nice-dns-pihole
COPY --chmod=644 pihole/merge-lists.sql /usr/share/nice-dns/pihole/merge-lists.sql
COPY --chmod=755 pihole/nd-start.sh /usr/local/bin/nd-start.sh

# Lock down the FTL-managed config files copied in above. The hardened base's
# post-install.sh below re-applies blanket 600/700 permissions, so this is
# belt-and-braces.
RUN [ -f /etc/pihole/dns-servers.conf ] && chmod 400 /etc/pihole/dns-servers.conf || true; \
    [ -f /etc/pihole/dnsmasq.conf ] && chmod 400 /etc/pihole/dnsmasq.conf || true

# Apply the hardened base's lockdown (removes apk + chown, freezes /pihole,
# /etc/pihole, /var/log/pihole, /opt/pihole, /var/www/html). After this RUN
# the image is read-only; downstream rebuilds must change the FROM line, not
# layer on more state.
RUN /pihole/post-install.sh

USER pihole

# nd-start.sh (the admin secret and the operator's lists) runs first, then the
# base's own /bin/start.sh.
ENTRYPOINT ["tini", "--", "/usr/local/bin/nd-start.sh"]
CMD ["/bin/start.sh"]
