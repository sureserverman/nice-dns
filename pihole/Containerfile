# The installers pass the reviewed digest from release/images.lock as
# BASE_IMAGE (Sub-plan 4 Task 1.3); the default keeps a plain build working.
ARG BASE_IMAGE=pihole/pihole:latest
FROM ${BASE_IMAGE}

RUN apk -U --no-cache upgrade \
    && apk add --no-cache tini

COPY --chown=pihole:pihole etc/* /etc/pihole/

# Build gravity.db at IMAGE BUILD TIME from the URL list. This recreates the
# original "fast first-start" UX (where gravity.db was committed to git as a
# 100 MB binary blob) without putting the binary in source. The container's
# /etc/resolv.conf during build inherits the host's working DNS, so blocklist
# downloads succeed cleanly here — unlike at first-container-start where
# rootless aardvark-DNS can't be reached from inside the container.
#
# gravity.db lives on the lists volume, /var/lib/nice-dns-pihole
# (pihole.toml files.gravity; Sub-plan 4 Task 2.2). The build's copy is also
# kept as this image's seed, with its id, for nd-start.sh.
COPY --chown=pihole:pihole adlists-default.txt /tmp/adlists.txt
COPY --chown=pihole:pihole custom-allowlist.txt /tmp/allowlist.txt
RUN set -e \
    && mkdir -p /var/lib/nice-dns-pihole /usr/share/nice-dns/pihole \
    && chown pihole:pihole /var/lib/nice-dns-pihole && chmod 700 /var/lib/nice-dns-pihole \
    && grep -vE '^[[:space:]]*(#|$)' /tmp/adlists.txt > /etc/pihole/adlists.list \
    && chown pihole:pihole /etc/pihole/adlists.list \
    && pihole -g \
    && grep -vE '^[[:space:]]*(#|$)' /tmp/allowlist.txt | while IFS= read -r d; do \
         pihole-FTL sqlite3 -ni /var/lib/nice-dns-pihole/gravity.db \
           "INSERT OR IGNORE INTO domainlist (type, domain, enabled, comment) \
            VALUES (0, '$d', 1, 'Seeded at image build time (allowlist)');"; \
       done \
    && rm /tmp/adlists.txt /tmp/allowlist.txt \
    && cp /var/lib/nice-dns-pihole/gravity.db /usr/share/nice-dns/pihole/gravity.seed.db \
    && sha256sum /usr/share/nice-dns/pihole/gravity.seed.db | cut -c1-64 >/usr/share/nice-dns/pihole/seed-id \
    && cp /usr/share/nice-dns/pihole/seed-id /var/lib/nice-dns-pihole/seed-id \
    && chown -R pihole:pihole /var/lib/nice-dns-pihole

# Harden: lock down config, remove apk
RUN chmod 400 /etc/pihole/dns-servers.conf /etc/pihole/dnsmasq.conf \
    && find / -type f -iname '*apk*' -xdev -delete \
    && find / -type d -iname '*apk*' -print0 -xdev | xargs -0 rm -r --

# nd-start.sh refuses an unusable WEBPASSWORD_FILE and carries the operator's
# lists into this image's seed, then execs upstream's start.sh.
COPY --chmod=644 merge-lists.sql /usr/share/nice-dns/pihole/merge-lists.sql
COPY --chmod=755 nd-start.sh /usr/local/bin/nd-start.sh
ENTRYPOINT ["tini", "--", "nd-start.sh", "start.sh"]
