#!/usr/bin/env bash
# Pre-seed pi-hole's dnsmasq cache with frequently-queried domains right
# after the stack reports healthy. Reduces cold-query latency for the
# user's first 30s of activity from "~600ms via .onion" to "0ms cached".
#
# Runs as a oneshot user-service after pi-hole.service is Active. Reads
# the domain list from ~/.config/nice-dns/warmup-domains.txt (installed
# by persistent-podman.sh). Each query is fire-and-forget — a failure
# means that single domain isn't cached, never aborts the warmup.

set -uo pipefail

DOMAINS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/nice-dns/warmup-domains.txt"
if [ ! -r "$DOMAINS_FILE" ]; then
    echo "nice-dns-warmup: $DOMAINS_FILE not found, nothing to do." >&2
    exit 0
fi

# Pi-hole listens on 127.0.0.1:53 once it's healthy. Verify it's actually
# answering before spraying queries — otherwise the first 5-10 attempts
# would just SERVFAIL and waste cycles. Try for up to 60s after service
# start (pi-hole.service is in our After= chain so this is the upper
# bound for any post-promotion settling).
echo "nice-dns-warmup: waiting up to 60s for pi-hole to answer..."
ready=no
for i in $(seq 1 20); do
    if dig +short +tries=1 +timeout=3 @127.0.0.1 example.com >/dev/null 2>&1; then
        ready=yes
        break
    fi
    sleep 3
done
if [ "$ready" != "yes" ]; then
    echo "nice-dns-warmup: pi-hole not answering after 60s — giving up." >&2
    exit 1
fi
echo "nice-dns-warmup: pi-hole answering; seeding cache."

# Emit each domain. The script reads `domain # optional comment` lines and
# skips blank / comment-only ones.
ok=0
fail=0
while IFS= read -r raw; do
    domain="${raw%%#*}"            # strip inline comments
    domain="${domain//[[:space:]]/}" # strip whitespace
    [ -z "$domain" ] && continue
    # 5s budget per query — enough for a cold .onion if the chain hasn't
    # fully promoted to primary, not so long that one slow domain stalls
    # the rest. +tries=1 to avoid the default 3× retry on transient fail.
    if dig +short +tries=1 +timeout=5 @127.0.0.1 "$domain" >/dev/null 2>&1; then
        ok=$((ok + 1))
        echo "  ok    $domain"
    else
        fail=$((fail + 1))
        echo "  fail  $domain"
    fi
done < "$DOMAINS_FILE"

echo "nice-dns-warmup: done — $ok succeeded, $fail failed."
exit 0
