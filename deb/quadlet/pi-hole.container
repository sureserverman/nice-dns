[Unit]
Description=Pi-hole DNS sinkhole
# Wants= plus After= (not Requires=): pi-hole starts after unbound.service
# reaches Active=active. Not Requires=: under systemd.unit(5) an explicit
# restart of a required unit also restarts this one, so a restart of Unbound
# or of the proxy before it would restart Pi-hole too (Sub-plan 3 close-out,
# M2).
Wants=unbound.service
After=unbound.service

[Container]
ContainerName=pi-hole
Image=localhost/pi-hole:latest
Pod=nice-dns.pod
# The operator's lists (gravity.db: allow/deny rules, groups, clients, added
# blocklists) survive a new container and a new image; pihole/nd-start.sh
# carries them into each image's seed (Sub-plan 4 Task 2.2). Uninstall
# removes the volume.
Volume=nice-dns-pihole-lists:/var/lib/nice-dns-pihole
# Capabilities and NoNewPrivileges are per image, in the drop-in
# pi-hole.container.d/50-nice-dns-caps.conf that persistent-podman.sh installs
# from pi-hole-{standard,hardened}.conf. The standard image's entrypoint
# starts as root, setcaps pihole-FTL and drops to the `pihole` user (uid
# 1000), so it cannot run with no-new-privs ("dnsmasq: failed to create
# listening socket for port 53: Permission denied"); the hardened image can.
Environment=TZ=Europe/London
# The admin password: one per deployment, a podman secret the installer
# creates from ~/.local/state/nice-dns/secrets/pihole/pihole_webpassword.
# Both images read /run/secrets/$WEBPASSWORD_FILE (Pi-hole's Docker secret
# contract); uid 1000 is the pihole user of both, so the hardened image,
# which starts as that user, can read it. Never the password itself in an
# Environment= line: it would show in `podman inspect`.
Secret=nice-dns-pihole-webpassword,type=mount,target=pihole_webpassword,uid=1000,gid=1000,mode=0400
Environment=WEBPASSWORD_FILE=pihole_webpassword
# Unbound listens on port 5335; without the explicit #5335 suffix pi-hole
# would default to port 53 and get connection-refused. (gravity is built
# into the image so this only affects pihole-FTL's runtime forwarding,
# not first-start bootstrap.)
Environment=DNS1=127.0.0.1#5335
Environment=DISABLE_GITHUB_UPDATES=true
HealthCmd=dig -p $(pihole-FTL --config dns.port) +short +norecurse +retry=0 @127.0.0.1 pi.hole 2>/dev/null | grep -q '^[^;]' || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# 90s gives pihole-FTL plenty of time to initialize. Gravity is pre-built
# in the image so no first-start gravity download is required.
HealthStartPeriod=90s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
