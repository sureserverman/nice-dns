[Unit]
Description=Pi-hole DNS sinkhole
# Requires= (not just After=) so pi-hole blocks on unbound.service reaching
# Active=active. With unbound chained on tor-haproxy and tor-haproxy waiting
# for healthy, this means pi-hole only starts answering port 53 once the
# full chain is serving.
Requires=unbound.service
After=unbound.service

[Container]
ContainerName=pi-hole
Image=localhost/pi-hole:latest
Pod=nice-dns.pod
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. Pi-hole's entrypoint
# starts as root, setcaps CAP_CHOWN + CAP_NET_BIND_SERVICE on pihole-FTL,
# then drops to the `pihole` user (uid 1000) and execs pihole-FTL — which
# binds port 53 via that file-cap. no-new-privs strips file-caps at exec,
# so adding it here causes "dnsmasq: failed to create listening socket for
# port 53: Permission denied" at startup. Same root cause as the matching
# omission on tor-haproxy.container / tor-socat.container.
Environment=TZ=Europe/London
# Unbound listens on port 5335; without the explicit #5335 suffix pi-hole
# would default to port 53 and get connection-refused. (gravity is built
# into the image so this only affects pihole-FTL's runtime forwarding,
# not first-start bootstrap.)
Environment=DNS1=127.0.0.1#5335
Environment=DISABLE_GITHUB_UPDATES=true
HealthCmd=dig -p $(pihole-FTL --config dns.port) +short +norecurse +retry=0 @127.0.0.1 pi.hole || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# 90s gives pihole-FTL plenty of time to initialize. Gravity is pre-built
# in the image so no first-start gravity download is required.
HealthStartPeriod=90s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
