[Unit]
Description=Tor socat DNS-over-TLS proxy
# See tor-haproxy.container for rationale — refresh bridges before reading
# bridges.env, Wants= so a Moat outage at boot doesn't strand the stack.
Wants=nice-dns-fetch-bridges.service
After=nice-dns-fetch-bridges.service

[Container]
ContainerName=tor-socat
Image=docker.io/sureserver/tor-socat:latest
Pod=nice-dns.pod
# Tor's state (DataDirectory /app/data/tor: guards, consensus, descriptors)
# survives a new container, so a restart does not bootstrap from nothing
# (Sub-plan 4 Task 2.2, ARCH-06). Podman seeds the named volume from the
# image's /app/data, owned by the image's user. Uninstall removes it.
Volume=nice-dns-tor-socat:/app/data
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. Same reason as
# tor-haproxy.container: the image runs as USER app (uid 1000) and grants
# socat CAP_NET_BIND_SERVICE via file-cap to bind port 853. no-new-privs
# strips file-caps at exec.
EnvironmentFile=%h/.config/nice-dns/bridges.env
# The bridges mode (nice-dns bridges on|off): systemd reads the optional
# bridges-mode.env ([Service] below) and this passes TOR_BRIDGES in; unset
# stays unset and the image defaults to on. Not an EnvironmentFile= here:
# that is podman's --env-file, which takes no `-` and needs the file.
PodmanArgs=--env TOR_BRIDGES
# Notify= deliberately not set — see tor-haproxy.container for the
# full rationale. Short version: tying the unit's Active=active to
# real DoT resolution success makes the whole stack fail to start
# whenever Tor is degraded for >TimeoutStartSec, which is the
# opposite of the project goal of "resolve via any backend ASAP."
# Health reports; it never restarts. The image's verifying route probe; see
# tor-haproxy.container for the rationale and history.
HealthCmd=nice-dns-route-probe 853 tor.cloudflare-dns.com
HealthInterval=60s
HealthTimeout=15s
HealthRetries=3
HealthStartPeriod=300s
HealthOnFailure=none

[Service]
EnvironmentFile=-%h/.config/nice-dns/bridges-mode.env
Restart=on-failure
# Back off when the container keeps exiting (systemd 254: RestartSteps=,
# RestartMaxDelaySec=; they need a non-zero RestartSec=). On 2026-11-02 VM
# memory exhaustion aborted haproxy (rc 134) and its unit restarted every
# 3 s for 20 hours, about 1100 times an hour: StartLimitBurst never trips
# at that cadence. Now the delay grows from 3 s to 5 min in 5 steps.
RestartSec=3s
RestartSteps=5
RestartMaxDelaySec=300s
TimeoutStopSec=70

[Install]
WantedBy=default.target
