[Unit]
Description=Tor HAProxy DNS-over-TLS proxy

[Container]
ContainerName=tor-haproxy
Image=docker.io/sureserver/tor-haproxy:latest
Pod=nice-dns.pod
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. The image runs as
# USER app (uid 1000) and grants haproxy CAP_NET_BIND_SERVICE via file-cap
# (cap_net_bind_service+ep on /usr/sbin/haproxy) so it can bind port 853.
# no-new-privs strips file-caps at exec, so adding it here causes haproxy
# to fail with "Permission denied" binding 0.0.0.0:853 and the stack never
# becomes healthy. Restoring this hardening would require an image-side
# change (wrap haproxy in `capsh --addamb=cap_net_bind_service`).
EnvironmentFile=%h/.config/nice-dns/bridges.env
HealthCmd=dig +short +tls -p 853 @127.0.0.1 cloudflare.com | grep -Eo '\b[0-9.]{7,15}\b' >/dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# 180s covers cold-cache obfs4 bridge bootstrap with 3 bridges (Conflux mode).
# Tor reaches Bootstrapped 100% as soon as ANY of the 3 bridges connects, so
# the previous 600s window — sized for the 2-bridge case where a single slow
# obfs4 handshake blocked the whole bootstrap for ~5 min before failover — is
# overkill. Observed cold-bootstrap healthy times across test runs: 30-90s.
# 180s = 2× worst observed + buffer; keeps "is the stack broken or just
# starting?" UX bounded at 3 min. Steady-state restarts (stuck circuit) fire
# normally outside this window.
HealthStartPeriod=180s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
