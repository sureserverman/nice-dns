[Unit]
Description=Tor HAProxy DNS-over-TLS proxy
# Refresh bridges from Tor Moat (latency-probed, fastest /24-distinct 3) on
# every session start, before this container reads bridges.env via
# EnvironmentFile= below. Wants= (not Requires=) so a transient Moat outage
# at boot doesn't keep the stack down — the fetch service exits non-zero
# without touching bridges.env, and we fall back to the previously-written
# pool. nice-dns-fetch-bridges.service is installed by deb/persistent-podman.sh.
Wants=nice-dns-fetch-bridges.service
After=nice-dns-fetch-bridges.service

[Container]
ContainerName=tor-haproxy
Image=docker.io/sureserver/tor-haproxy:latest
Pod=nice-dns.pod
# Tor's state (DataDirectory /app/data/tor: guards, consensus, descriptors)
# survives a new container, so a restart does not bootstrap from nothing
# (Sub-plan 4 Task 2.2, ARCH-06). Podman seeds the named volume from the
# image's /app/data, owned by the image's user. Uninstall removes it.
Volume=nice-dns-tor-haproxy:/app/data
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. The image runs as
# USER app (uid 1000) and grants haproxy CAP_NET_BIND_SERVICE via file-cap
# (cap_net_bind_service+ep on /usr/sbin/haproxy) so it can bind port 853.
# no-new-privs strips file-caps at exec, so adding it here causes haproxy
# to fail with "Permission denied" binding 0.0.0.0:853 and the stack never
# becomes healthy. Restoring this hardening would require an image-side
# change (wrap haproxy in `capsh --addamb=cap_net_bind_service`).
EnvironmentFile=%h/.config/nice-dns/bridges.env
# Notify= deliberately NOT set. The Stage 2 design (Notify=healthy, so
# systemd waits for the HealthCmd to pass) was reverted because it
# gates the unit's Active=active transition on real DoT resolution
# succeeding through the chain — which on degraded Tor (slow obfs4
# bridges or congested exit) can take >5 min. With Notify=healthy the
# whole unit then fails to start, dependent services never come up,
# and the user-visible result is "no DNS at all" even though Tor and
# haproxy themselves are running fine.
#
# The user's stated goal is "resolve via any backend ASAP," which
# wants the unit active as soon as the container's processes exist.
# Dependent services (unbound, pi-hole) still wait via After=, but
# they wait for the *container* to be up, not for end-to-end DNS to
# work (Wants= plus After=, so the controller's restart of this unit does
# not restart them). The latency-aware probe (Stage 7) keeps primary in
# the right state. Cold-start may show a brief SERVFAIL window
# (seconds) before backup or primary starts answering — but that's
# strictly better than "service refuses to start."
# Health reports; it never restarts (HealthOnFailure=none). The check is the
# image's verifying route probe: a DNS-over-TLS query through Tor to the
# legacy :853 route, certificate and name checked, its whole run bounded
# (NICE_DNS_PROBE_TIMEOUT, 10 s).
#
# History. An end-to-end check that restarted on failure looped: a container
# restart wipes Tor's bootstrap progress, so on a congested exit the chain
# never stabilised (a restart every ~3.5 min, each bootstrap 60-90 s). Its
# replacement, a restarting loopback `nc -z 127.0.0.1 853`, never saw a chain
# fault: in Sub-plan 1's live Tor freeze it stayed green while Podman
# restarted Unbound and Pi-hole instead. Since Sub-plan 3 the nice-dns-health
# controller is the one actor that restarts Tor or this service, with its
# grace, cooldown and restart ladder (lib/policy.sh); a second owner here
# would race it. A process that exits is still restarted by Restart= below.
# An image without the probe (published before Sub-plan 2) reports
# unhealthy and nothing acts on it.
HealthCmd=nice-dns-route-probe 853 tor.cloudflare-dns.com
HealthInterval=60s
HealthTimeout=15s
HealthRetries=3
# A cold obfs4 bootstrap plus the first onion rendezvous can take minutes;
# failures inside this window do not count, so the state reads "starting".
HealthStartPeriod=300s
HealthOnFailure=none

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
