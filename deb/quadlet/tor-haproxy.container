[Unit]
Description=Tor HAProxy DNS-over-TLS proxy
# Refresh bridges from Tor Moat (latency-probed, fastest /24-distinct 3) on
# every session start, before this container reads bridges.env via
# EnvironmentFile= below. Wants= (not Requires=) so a transient Moat outage
# at boot doesn't keep the stack down — the fetch service exits non-zero
# without touching bridges.env, and we fall back to the previously-written
# pool. nice-dns-fetch-bridges.service is installed by deb/persistent-podman.sh.
Wants=nice-dns-fetch-bridges.service
After=nice-dns-fetch-bridges.service

[Container]
ContainerName=tor-haproxy
Image=docker.io/sureserver/tor-haproxy:latest
Pod=nice-dns.pod
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. The image runs as
# USER app (uid 1000) and grants haproxy CAP_NET_BIND_SERVICE via file-cap
# (cap_net_bind_service+ep on /usr/sbin/haproxy) so it can bind port 853.
# no-new-privs strips file-caps at exec, so adding it here causes haproxy
# to fail with "Permission denied" binding 0.0.0.0:853 and the stack never
# becomes healthy. Restoring this hardening would require an image-side
# change (wrap haproxy in `capsh --addamb=cap_net_bind_service`).
EnvironmentFile=%h/.config/nice-dns/bridges.env
# Stage 2 (reliability plan): only report Active=active to systemd once the
# container's healthcheck transitions to healthy. Lets dependent services
# (unbound, pi-hole) use Requires=/After=tor-haproxy.service to actually
# wait for a serving backend, not just for the haproxy process to start.
# `Notify=healthy` requires podman ≥ 5.2 (Sep 2024) and maps to
# `--sdnotify=healthy` — postpones the systemd READY=1 notification until
# the HealthCmd below reports healthy. The earlier Notify=true +
# PodmanArgs=--sdnotify=healthy combo didn't work in podman 5.8 because
# Notify=true emits --sdnotify=container *first* on the CLI and podman's
# flag parser took the first value, not the last.
Notify=healthy
HealthCmd=dig +short +tls -p 853 @127.0.0.1 cloudflare.com | grep -Eo '\b[0-9.]{7,15}\b' >/dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# 60s covers warm-Tor bootstrap (cached consensus, ~30s) plus the first
# backend health probe (which goes to backup, ~5s, since primary starts
# init-state down). Note: container healthy is independent of primary
# being UP — the haproxy HealthCmd just verifies that *any* backend
# (primary/backup/fallback) answers a dig, so backup serving during
# the primary-promotion window counts as healthy. Primary's own
# promotion to UP takes ≥ 90s on warm Tor (rise 3 × inter 30s) which
# is intentional ("stable before preferred"). The previous 180s start
# period was sized for cold obfs4 bootstrap (~90s) + the old rise-2
# inter-30s promotion (~60s); both are now faster and the start period
# is deliberately *under* worst-case cold so real boot failures surface
# as unhealthy instead of being masked.
HealthStartPeriod=60s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
