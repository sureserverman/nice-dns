[Unit]
Description=Tor HAProxy DNS-over-TLS proxy
# Refresh bridges from Tor Moat (latency-probed, fastest /24-distinct 3) on
# every session start, before this container reads bridges.env via
# EnvironmentFile= below. Wants= (not Requires=) so a transient Moat outage
# at boot doesn't keep the stack down — the fetch service exits non-zero
# without touching bridges.env, and we fall back to the previously-written
# pool. nice-dns-fetch-bridges.service is installed by deb/persistent-podman.sh.
Wants=nice-dns-fetch-bridges.service
After=nice-dns-fetch-bridges.service

[Container]
ContainerName=tor-haproxy
Image=docker.io/sureserver/tor-haproxy:latest
Pod=nice-dns.pod
# NoNewPrivileges=true is INTENTIONALLY OMITTED here. The image runs as
# USER app (uid 1000) and grants haproxy CAP_NET_BIND_SERVICE via file-cap
# (cap_net_bind_service+ep on /usr/sbin/haproxy) so it can bind port 853.
# no-new-privs strips file-caps at exec, so adding it here causes haproxy
# to fail with "Permission denied" binding 0.0.0.0:853 and the stack never
# becomes healthy. Restoring this hardening would require an image-side
# change (wrap haproxy in `capsh --addamb=cap_net_bind_service`).
EnvironmentFile=%h/.config/nice-dns/bridges.env
# Notify= deliberately NOT set. The Stage 2 design (Notify=healthy, so
# systemd waits for the HealthCmd to pass) was reverted because it
# gates the unit's Active=active transition on real DoT resolution
# succeeding through the chain — which on degraded Tor (slow obfs4
# bridges or congested exit) can take >5 min. With Notify=healthy the
# whole unit then fails to start, dependent services never come up,
# and the user-visible result is "no DNS at all" even though Tor and
# haproxy themselves are running fine.
#
# The user's stated goal is "resolve via any backend ASAP," which
# wants the unit active as soon as the container's processes exist.
# Dependent services (unbound, pi-hole) still wait via Requires=, but
# they wait for the *container* to be up, not for end-to-end DNS to
# work. Their own HealthCmds catch the cases where the chain is still
# settling, and the latency-aware probe (Stage 7) keeps primary in
# the right state. Cold-start may show a brief SERVFAIL window
# (seconds) before backup or primary starts answering — but that's
# strictly better than "service refuses to start."
# Anchored IPv4 regex (^...$) so the line MUST be a bare dotted-quad. The
# previous unanchored \b[0-9.]{7,15}\b matched the "127.0.0.1" substring
# inside dig's "Connection to 127.0.0.1#853 failed" error line — which
# Alpine's bind-tools dig writes to STDOUT (not stderr) on a closed port,
# so the healthcheck reported `healthy` before haproxy was even listening.
# `grep -m1 -Eq` exits 0 on first match, 1 on no matches.
#
# `tries=1 time=20`: one attempt, 20s budget. The default `tries=3 time=5`
# gives up at 15s but in practice does 3 short attempts that don't add
# anything when ONE upstream is consistently slow — measured backup-via-
# Tor-exit query times of 5-28s mean a single longer try is more useful
# than three short ones.
HealthCmd=dig +short +tls +tries=1 +time=20 -p 853 @127.0.0.1 cloudflare.com | grep -m1 -Eq '^([0-9]+\\.){3}[0-9]+$'
HealthInterval=30s
# 25s gives the dig command (20s budget) a 5s buffer for fork + setup.
# Tor-exit DoT queries can take that long when the network is degraded.
HealthTimeout=25s
HealthRetries=5
# 60s covers warm-Tor bootstrap (cached consensus, ~30s) plus the first
# backend health probe (which goes to backup, ~5s, since primary starts
# init-state down). Note: container healthy is independent of primary
# being UP — the haproxy HealthCmd just verifies that *any* backend
# (primary/backup/fallback) answers a dig, so backup serving during
# the primary-promotion window counts as healthy. Primary's own
# promotion to UP takes ≥ 90s on warm Tor (rise 3 × inter 30s) which
# is intentional ("stable before preferred"). The previous 180s start
# period was sized for cold obfs4 bootstrap (~90s) + the old rise-2
# inter-30s promotion (~60s); both are now faster and the start period
# is deliberately *under* worst-case cold so real boot failures surface
# as unhealthy instead of being masked.
HealthStartPeriod=60s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
