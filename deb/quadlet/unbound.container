[Unit]
Description=Unbound recursive DNS resolver
# Requires= (not just After=) so unbound blocks on tor-haproxy.service
# reaching Active=active. Combined with tor-haproxy.container's
# Notify=healthy directive, systemd treats tor-haproxy as active only
# once its healthcheck passes — so unbound starts with a serving backend
# already available.
Requires=tor-__VARIANT__.service
After=tor-__VARIANT__.service

[Container]
ContainerName=unbound
Image=localhost/unbound:latest
Pod=nice-dns.pod
NoNewPrivileges=true
HealthCmd=dig +short -p 5335 @127.0.0.1 cloudflare.com | grep -Eo '\b[0-9.]{7,15}\b' >/dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# Match tor-haproxy's 60s start period. unbound depends on tor-haproxy for
# any successful upstream query, but with the wait-for-healthy gate
# (Stage 2 of the reliability plan) unbound only starts after tor-haproxy
# is already healthy, so unbound's own start period only needs to cover
# its internal init (cert load, cache prime) — sub-10s.
HealthStartPeriod=60s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
