[Unit]
Description=Unbound recursive DNS resolver
# Wants= plus After= (not Requires=): unbound starts after
# tor-__VARIANT__.service reaches Active=active. tor-haproxy reports active
# as soon as its container is up (Notify= deliberately unset there — see its
# file for rationale), so unbound starts shortly after the proxy is
# listening, even if the chain isn't yet resolving end-to-end. Not
# Requires=: under systemd.unit(5) an explicit restart of a required unit
# also restarts this one, so the controller's proxy restart would drop
# Unbound's cache and restart Pi-hole (Sub-plan 3 close-out, M2).
Wants=tor-__VARIANT__.service
After=tor-__VARIANT__.service

[Container]
ContainerName=unbound
Image=localhost/unbound:latest
Pod=nice-dns.pod
# The persistent root trust anchor (RFC 5011 state; ARCH-06). Podman seeds
# the named volume from the image's /var/lib/unbound (unbound, 0700), which
# nice-dns-unbound-start requires. Uninstall removes it.
Volume=nice-dns-unbound-anchor:/var/lib/unbound
# The selected route (ARCH-04, DEC-010): the host directory the controller
# manages (lib/recovery.sh apply_route), read-only; the directory, never the
# single include, so a route change is an atomic rename Unbound sees.
# persistent-podman.sh fills in the path (lib/platform/linux.sh
# nd_platform_route_dir) and seeds the directory when it is missing.
Volume=__ROUTE_DIR__:/etc/unbound/route:ro
NoNewPrivileges=true
# Health reports; it never restarts (see tor-haproxy.container: the
# nice-dns-health controller is the one restart owner). Healthy means Unbound
# answers on its local control socket and its selected route resolves in a
# fresh authenticated TLS session that bypasses the cache (probe-route,
# bounded by NICE_DNS_PROBE_TIMEOUT, 15 s). It therefore also reads unhealthy
# while Tor is down: that is the truth about uncached names.
HealthCmd=unbound-control -c /usr/share/nice-dns/control.conf status >/dev/null && nice-dns-unbound-start probe-route >/dev/null
HealthInterval=60s
HealthTimeout=30s
HealthRetries=3
# Unbound's upstream is the proxy, which may still be bootstrapping Tor.
HealthStartPeriod=300s
HealthOnFailure=none

[Service]
# Sub-plan 5 Task 1.4 (fix A, ARCH-04's startup rule): before every start the
# controller's launcher demotes a persisted onion route to the exit, so the
# first answers after a restart never wait for a cold rendezvous. "-": a
# missing launcher or a failure never blocks Unbound. persistent-podman.sh
# fills in the path.
ExecStartPre=-/bin/sh __HEALTH_ROOT__/route-start
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
