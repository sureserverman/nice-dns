[Unit]
Description=Unbound recursive DNS resolver
# Requires= (not just After=) so unbound blocks on tor-haproxy.service
# reaching Active=active. tor-haproxy reports active as soon as its
# container is up (Notify= deliberately unset there — see its file for
# rationale), so unbound starts shortly after haproxy is listening,
# even if the chain isn't yet resolving end-to-end. unbound's own
# healthcheck catches the "starting but not serving" window, and
# pi-hole chains on this same Requires=.
Requires=tor-__VARIANT__.service
After=tor-__VARIANT__.service

[Container]
ContainerName=unbound
Image=localhost/unbound:latest
Pod=nice-dns.pod
NoNewPrivileges=true
# Port-level check: is unbound listening on 5335? Same rationale as
# tor-haproxy.container — we test process aliveness here, and let
# nice-dns-health's chain-resolves check (Stage 5) detect end-to-end
# failures with its own grace window and graceful restart.
HealthCmd=nc -z 127.0.0.1 5335
HealthInterval=30s
# `nc -z` returns in <100ms. 5s is plenty.
HealthTimeout=5s
HealthRetries=5
# Match tor-haproxy's 60s start period. unbound depends on tor-haproxy for
# any successful upstream query, but with the wait-for-healthy gate
# (Stage 2 of the reliability plan) unbound only starts after tor-haproxy
# is already healthy, so unbound's own start period only needs to cover
# its internal init (cert load, cache prime) — sub-10s.
HealthStartPeriod=60s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
