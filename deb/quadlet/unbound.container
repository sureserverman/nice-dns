[Unit]
Description=Unbound recursive DNS resolver
After=tor-__VARIANT__.service

[Container]
ContainerName=unbound
Image=localhost/unbound:latest
Pod=nice-dns.pod
HealthCmd=dig +short -p 5335 @127.0.0.1 cloudflare.com | grep -Eo '\b[0-9.]{7,15}\b' >/dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# unbound forwards via DoT through tor-haproxy → Tor → Cloudflare's hidden
# resolver, so its first successful query depends on Tor finishing bootstrap.
# Match tor-haproxy's 180s start period so a slow first-run obfs4 handshake
# does not trigger a kill-and-retry loop here either.
HealthStartPeriod=180s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStopSec=70

[Install]
WantedBy=default.target
