#!/usr/bin/env bash
# nice-dns resolver helper (Linux, root). Sub-plan 4 Task 1.2 (ARCH-06,
# WF-DNS-003): the only code that changes the host resolver.
#
#   custom-dns-deb [pin]   point /etc/resolv.conf at the stack (127.0.0.1).
#                          The boot oneshot and the NetworkManager dispatcher
#                          hook run it with no argument.
#   custom-dns-deb check   exit 3 when another owner changed the resolver
#                          after nice-dns pinned it; an install refuses then.
#   custom-dns-deb snapshot
#                          record the resolver state nice-dns will change
#                          (first install only; a reinstall keeps the first
#                          record, which is the state before nice-dns).
#   custom-dns-deb restore undo the pin from that record (uninstall).
#   custom-dns-deb status  print pinned or unpinned.
#   custom-dns-deb discard drop an unused record: a first install that failed
#                          before its pin (refused once the pin is in place).
#   custom-dns-deb ipv6-profiles  turn IPv6 off in each Ethernet and Wi-Fi
#                          profile on disk, recording its method (install).
#   custom-dns-deb ipv6-profiles-undo  give back what the last ipv6-profiles
#                          run changed (a reinstall's rollback).
#   custom-dns-deb ipv6-profiles-done  drop that run's undo list (the
#                          install succeeded).
#
# Only these are owned: /etc/resolv.conf, systemd-resolved's enabled and
# active state, the ipv6 sysctl runtime values (all, default, lo, and each
# device's own switch as a first install recorded it in ipv6-devices.tsv
# beside the record), and the nice-dns-named files in OWNED_FILES; on a host
# an older installer set up (origin legacy), also the NetworkManager
# connection profiles it pinned: ipv4 DNS exactly
# 127.0.0.1 with automatic DNS ignored (user decision 2026-09-28, after mint
# was left without DNS by an uninstall that kept them); and the ipv6.method
# of each Ethernet and Wi-Fi profile ipv6-profiles disabled, as recorded in
# ipv6-profiles.tsv beside the record (user decision 2026-10-12, DEC-020).
# VPN and other network configuration are never touched.
# The record lives in a root-only directory; it is data, never sourced.
#
# ND_DNS_TEST_ROOT prefixes every path for the fixture tests. It is honoured
# only when not running as root, so a root run always acts on the real host.
set -euo pipefail

R=""
if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  if [[ -n ${ND_DNS_TEST_ROOT:-} ]]; then
    R="$ND_DNS_TEST_ROOT"
  else
    echo "custom-dns-deb: must be run as root." >&2
    exit 1
  fi
fi

RESOLV="$R/etc/resolv.conf"
RECEIPT_DIR="$R/var/lib/nice-dns/dns-owned"
RECEIPT="$RECEIPT_DIR/receipt.tsv"
SCHEMA='nice-dns-dns-owned/1'
PIN='nameserver 127.0.0.1'
OWNED_FILES=(
  "$R/etc/NetworkManager/conf.d/90-nice-dns.conf"
  "$R/etc/NetworkManager/dispatcher.d/90-nice-dns-pin"
  "$R/etc/NetworkManager/dispatcher.d/91-nice-dns-ipv6"
  "$R/etc/NetworkManager/dispatcher.d/pre-up.d/91-nice-dns-ipv6"
  "$R/etc/systemd/system/NetworkManager-wait-online.service.d/10-wait-for-connectivity.conf"
  "$R/etc/sysctl.d/99-nice-dns-disable-ipv6.conf"
  "$R/etc/systemd/system/custom-dns-deb.service"
)
SYSCTL_KEYS="net.ipv6.conf.all.disable_ipv6 net.ipv6.conf.default.disable_ipv6 net.ipv6.conf.lo.disable_ipv6"
IPV6_DEVICES="$RECEIPT_DIR/ipv6-devices.tsv"
IPV6_PROFILES="$RECEIPT_DIR/ipv6-profiles.tsv"
# This install run's profile changes (uuid, method before) and the record
# as it was before the run, for a reinstall's rollback (ipv6-profiles-undo).
IPV6_PROFILES_RUN="$RECEIPT_DIR/ipv6-profiles.run"
IPV6_PROFILES_PREV="$RECEIPT_DIR/ipv6-profiles.prev"

# restore_ipv6_devices: each recorded device gets its value from before
# nice-dns (its first row) back; a device that is gone is skipped. With a
# fresh record a device with no row keeps the restored `all` value, which the
# kernel applied to it; a legacy restore (sysctl --system) leaves it as is. After the hook itself is removed,
# so NetworkManager no longer switches it off again.
restore_ipv6_devices() {
  local d v
  [[ -f $IPV6_DEVICES && ! -L $IPV6_DEVICES ]] || return 0
  while IFS=$'\t' read -r d v; do
    [[ $d =~ ^[A-Za-z0-9_.:-]{1,15}$ && $d != . && $d != .. ]] || continue
    case "$v" in 0|1) ;; *) continue ;; esac
    [[ -f $R/proc/sys/net/ipv6/conf/$d/disable_ipv6 ]] || continue
    printf '%s\n' "$v" 2>/dev/null >"$R/proc/sys/net/ipv6/conf/$d/disable_ipv6" || true
  done < <(awk -F '\t' '!seen[$1]++' "$IPV6_DEVICES")
}

# pinned: resolv.conf is the regular file nice-dns writes (one nameserver, 127.0.0.1).
pinned() {
  [[ -f $RESOLV && ! -L $RESOLV ]] || return 1
  [[ "$(grep -E '^[[:space:]]*nameserver' "$RESOLV" | awk '{ print $2 }' | sort -u)" == 127.0.0.1 ]]
}

receipt_get() { awk -F '\t' -v k="$1" 'NR == 1 && $0 != "schema\t'"$SCHEMA"'" { exit 1 } $1 == k { print $2; exit }' "$RECEIPT"; }
receipt_ok() {
  [[ -d $RECEIPT_DIR && ! -L $RECEIPT_DIR && -f $RECEIPT && ! -L $RECEIPT ]] || return 1
  [[ "$(head -n 1 "$RECEIPT")" == "schema	$SCHEMA" ]]
}

unit_state() { # <is-enabled|is-active> <unit>: the value, or 'absent'
  local v
  if ! systemctl cat "$2" >/dev/null 2>&1; then echo absent; return 0; fi
  v="$(systemctl "$1" "$2" 2>/dev/null || true)"
  echo "${v:-unknown}"
}

# nm_pinned_profiles: UUIDs of the connection profiles pinned the way older
# nice-dns installers pinned them: ipv4 DNS exactly 127.0.0.1, automatic DNS
# ignored. Nothing when NetworkManager's CLI is absent.
nm_pinned_profiles() {
  command -v nmcli >/dev/null 2>&1 || return 0
  local u
  # No statement here may end non-zero: under set -e and pipefail a caller's
  # pipeline would abort (Tier-1 review: a last profile that is not a pin
  # ended the loop with 1 and killed the snapshot before its record).
  { nmcli -t -f UUID con show 2>/dev/null || true; } | while IFS= read -r u; do
    [[ -n $u ]] || continue
    if [[ "$(nmcli -g ipv4.dns,ipv4.ignore-auto-dns con show "$u" 2>/dev/null | tr '\n' ' ')" == "127.0.0.1 yes " ]]; then
      printf '%s\n' "$u"
    fi
  done
  return 0
}

# nm_answers: NetworkManager's CLI is absent, or NetworkManager answers.
# Where a profile is read to record it or give it back, a CLI that is there
# but gets no answer must not read as "no such profile" (Stage 3 gate class
# sweep, 2026-10-12: an uninstall with NetworkManager down read every legacy
# pin as changed since and dropped the record, leaving the pins).
nm_answers() {
  ! command -v nmcli >/dev/null 2>&1 || nmcli -t -f UUID con show >/dev/null 2>&1
}

# nm_profile_devices <uuid>: the devices a profile is active on, one per
# line (a bond or team lists several), each a valid interface name that
# cannot be read as an option.
nm_profile_devices() {
  local dev d
  dev="$(nmcli -g GENERAL.DEVICES con show "$1" 2>/dev/null || true)"
  IFS=, read -ra d <<<"$dev"
  for dev in "${d[@]}"; do
    [[ $dev =~ ^[A-Za-z0-9_.:][A-Za-z0-9_.:-]{0,14}$ ]] && printf '%s\n' "$dev"
  done
  return 0
}

# NM_UUID_ERE: a profile UUID as the helper accepts it (letters, digits and
# '-', never a leading '-', which nmcli would read as an option).
NM_UUID_ERE='^[A-Za-z0-9][A-Za-z0-9-]{0,63}$'

# nm_unpin_legacy <uuid...>: each profile still pinned as recorded goes back
# to automatic DNS and is reapplied on its device; one changed since by
# another owner is left alone. Exit 1 when a profile could not be reset.
nm_unpin_legacy() {
  local u d still rc=0
  # Without nmcli the profiles went with NetworkManager: name them and let
  # the restore complete (failing would keep every later uninstall failing).
  if ! command -v nmcli >/dev/null 2>&1; then
    echo "custom-dns-deb: nmcli is missing, so these legacy profile pins were not reset: $*" >&2
    return 0
  fi
  if ! nm_answers; then
    echo "custom-dns-deb: NetworkManager did not answer; the legacy profile pins cannot be reset" >&2
    return 1
  fi
  still="$(nm_pinned_profiles)"
  for u in "$@"; do
    if ! printf '%s\n' "$still" | grep -Fxq "$u"; then
      echo "custom-dns-deb: NetworkManager profile $u changed since the record; leaving it as it is" >&2
      continue
    fi
    if nmcli con mod "$u" ipv4.dns "" ipv4.ignore-auto-dns no >/dev/null 2>&1; then
      echo "custom-dns-deb: NetworkManager profile $u uses automatic DNS again"
      while IFS= read -r d; do
        nmcli dev reapply "$d" >/dev/null 2>&1 || echo "custom-dns-deb: could not reapply $d; reconnect it to use the new DNS" >&2
      done < <(nm_profile_devices "$u")
    else
      echo "custom-dns-deb: could not reset NetworkManager profile $u to automatic DNS" >&2
      rc=1
    fi
  done
  return "$rc"
}

# nm_v6_candidates: UUIDs of the connection profiles whose IPv6 nice-dns turns
# off: Ethernet and Wi-Fi profiles stored on disk (a keyfile under /etc, or
# one netplan generated). NetworkManager's in-memory external profiles, other
# types (Mullvad's WireGuard, VPNs, bridges) and loopback (nmcli refuses
# ipv6.method there) are left alone. Nothing when NetworkManager's CLI is
# absent.
nm_v6_candidates() {
  command -v nmcli >/dev/null 2>&1 || return 0
  local u t f
  # As in nm_pinned_profiles, no statement may end non-zero.
  { nmcli -t -f UUID,TYPE,FILENAME con show 2>/dev/null || true; } | while IFS=: read -r u t f; do
    case "$t" in 802-3-ethernet|802-11-wireless) ;; *) continue ;; esac
    case "${f//\\:/:}" in /etc/NetworkManager/system-connections/*|*/netplan-*) printf '%s\n' "$u" ;; esac
  done
  return 0
}

# cmd_ipv6_profiles: each candidate profile whose ipv6.method lets
# NetworkManager turn IPv6 on (auto, dhcp, manual, link-local or shared;
# disabled and ignore never do, an unknown method is left alone) is recorded
# in ipv6-profiles.tsv beside the record, set to disabled and reapplied on
# its device. The dispatcher hook alone leaves a window: NetworkManager sends
# pre-up only after it set up IP, and the NIC sent MLD and a duplicate-address
# check from :: at every activation (Stage 3 gate capture, 2026-10-12). Only
# with the record in place, so the restore can give every change back. The
# record holds the method the owner last set: the one found at the first
# install, or one the owner set since (a reinstall finds it, not disabled).
# A profile that cannot be changed is named and left as it is; the hook
# still covers its device, and a profile made later.
cmd_ipv6_profiles() {
  local u m rec d
  # Every run starts with no undo list, whatever it then does: a rollback
  # must never undo an earlier install from a leftover one (round-2 review).
  rm -f "$IPV6_PROFILES_RUN" "$IPV6_PROFILES_PREV"
  if ! receipt_ok; then
    echo "custom-dns-deb: no record of the state before nice-dns; no NetworkManager profile is changed" >&2
    return 0
  fi
  [[ ! -L $IPV6_PROFILES && ! -L $IPV6_PROFILES_RUN && ! -L $IPV6_PROFILES_PREV ]] || return 0
  command -v nmcli >/dev/null 2>&1 || return 0
  if ! nmcli -t -f UUID con show >/dev/null 2>&1; then
    echo "custom-dns-deb: NetworkManager did not answer; no profile's IPv6 is changed (the dispatcher hook still covers every device)" >&2
    return 0
  fi
  # This run's undo list, and the record as it was. Chained with && (a
  # subshell on the left of || runs without errexit).
  ( umask 077 && : >"$IPV6_PROFILES_RUN" &&
      { [[ ! -f $IPV6_PROFILES ]] || cp -p "$IPV6_PROFILES" "$IPV6_PROFILES_PREV"; } ) 2>/dev/null || {
    rm -f "$IPV6_PROFILES_RUN" "$IPV6_PROFILES_PREV"
    echo "custom-dns-deb: could not start this run's profile record; no profile's IPv6 is changed" >&2; return 0; }
  while IFS= read -r u; do
    [[ $u =~ $NM_UUID_ERE ]] || continue
    m="$(nmcli -g ipv6.method con show "$u" 2>/dev/null || true)"
    case "$m" in auto|dhcp|manual|link-local|shared) ;; *) continue ;; esac
    rec="$(awk -F '\t' -v u="$u" '$1 == u { print $2; exit }' "$IPV6_PROFILES" 2>/dev/null || true)"
    if [[ $rec != "$m" ]] && ! ipv6_profiles_set_row "$u" "$m"; then
      echo "custom-dns-deb: could not record NetworkManager profile $u; leaving it as it is" >&2
      continue
    fi
    if nmcli con mod "$u" ipv6.method disabled >/dev/null 2>&1; then
      if ! ( umask 077 && printf '%s\t%s\n' "$u" "$m" >>"$IPV6_PROFILES_RUN" ) 2>/dev/null; then
        # Not in the undo list: a rollback could not give it back. Undone now.
        nmcli con mod "$u" ipv6.method "$m" >/dev/null 2>&1 || true
        ipv6_profiles_set_row "$u" "$rec" || true
        echo "custom-dns-deb: could not list NetworkManager profile $u for a rollback; left as it was" >&2
        continue
      fi
      while IFS= read -r d; do
        nmcli dev reapply "$d" >/dev/null 2>&1 || echo "custom-dns-deb: could not reapply $d; it takes ipv6.method disabled at its next activation" >&2
      done < <(nm_profile_devices "$u")
    else
      # Nothing changed: the record goes back to what it held for it.
      ipv6_profiles_set_row "$u" "$rec" || true
      echo "custom-dns-deb: could not set ipv6.method disabled in NetworkManager profile $u (a static manual profile with addresses may refuse it); the dispatcher hook still covers its device" >&2
    fi
  done < <(nm_v6_candidates)
  return 0
}

# ipv6_profiles_set_row <uuid> <method|"">: the record's row for a profile is
# replaced by "<uuid> <method>", or dropped when the method is empty.
ipv6_profiles_set_row() {
  ( umask 077
    { awk -F '\t' -v u="$1" '$1 != u' "$IPV6_PROFILES" 2>/dev/null || true
      [[ -z $2 ]] || printf '%s\t%s\n' "$1" "$2"; } >"$IPV6_PROFILES.new" &&
      mv -f "$IPV6_PROFILES.new" "$IPV6_PROFILES" ) 2>/dev/null && return 0
  rm -f "$IPV6_PROFILES.new"
  return 1
}

# cmd_ipv6_profiles_undo: a reinstall that rolls back gives back what its own
# ipv6-profiles run changed: each profile it disabled that still reads
# disabled gets its method from before the run, and the record is what it
# was before the run. A profile the previous deployment had disabled stays
# so. Exit 1 when a profile cannot be reset (the run's list is then kept).
cmd_ipv6_profiles_undo() {
  local u m now st d rc=0
  [[ ! -L $RECEIPT_DIR && ! -L $IPV6_PROFILES && ! -L $IPV6_PROFILES_PREV ]] || return 1
  [[ -f $IPV6_PROFILES_RUN && ! -L $IPV6_PROFILES_RUN ]] || return 0
  while IFS=$'\t' read -r u m; do
    [[ $u =~ $NM_UUID_ERE ]] || continue
    case "$m" in auto|dhcp|manual|link-local|shared) ;; *) continue ;; esac
    if now="$(nmcli -g ipv6.method con show "$u" 2>/dev/null)"; then st=0; else st=$?; fi
    if (( st == 10 )); then continue
    elif (( st != 0 )); then
      echo "custom-dns-deb: could not read NetworkManager profile $u (nmcli exit $st; is NetworkManager running?)" >&2
      rc=1; continue
    fi
    [[ $now == disabled ]] || continue
    if nmcli con mod "$u" ipv6.method "$m" >/dev/null 2>&1; then
      echo "custom-dns-deb: NetworkManager profile $u has ipv6.method $m again"
      while IFS= read -r d; do nmcli dev reapply "$d" >/dev/null 2>&1 || true; done < <(nm_profile_devices "$u")
    else
      echo "custom-dns-deb: could not set NetworkManager profile $u back to ipv6.method $m" >&2
      rc=1
    fi
  done < <(awk -F '\t' '!seen[$1]++' "$IPV6_PROFILES_RUN")
  (( rc == 0 )) || return 1
  if [[ -f $IPV6_PROFILES_PREV && ! -L $IPV6_PROFILES_PREV ]]; then
    mv -f "$IPV6_PROFILES_PREV" "$IPV6_PROFILES"
  else
    rm -f "$IPV6_PROFILES"
  fi
  rm -f "$IPV6_PROFILES_RUN"
}

# cmd_ipv6_profiles_done: the install succeeded; its undo list is dropped,
# so nothing can undo it later.
cmd_ipv6_profiles_done() {
  rm -f "$IPV6_PROFILES_RUN" "$IPV6_PROFILES_PREV"
}

# restore_ipv6_profiles: each recorded profile still disabled gets its
# recorded method back and is reapplied. One that still has that method (its
# change failed) needs nothing; one another owner changed since is left
# alone and named; one that no longer exists (nmcli exit 10) is skipped.
# Exit 1, and the caller keeps the record, when a profile cannot be read or
# reset (NetworkManager not answering). Without nmcli, and for a malformed
# row, it names what it skips and completes.
restore_ipv6_profiles() {
  local u m now st d rc=0
  [[ -f $IPV6_PROFILES && ! -L $IPV6_PROFILES ]] || return 0
  # Without NetworkManager's CLI no profile can exist any more (it was
  # removed after the install): name what could not be given back and let
  # the restore complete; failing would keep every later uninstall failing.
  if ! command -v nmcli >/dev/null 2>&1; then
    echo "custom-dns-deb: nmcli is missing, so the IPv6 methods of these NetworkManager profiles were not given back: $(awk -F '\t' 'NF { printf "%s%s (%s)", s, $1, $2; s = ", " }' "$IPV6_PROFILES")" >&2
    return 0
  fi
  while IFS=$'\t' read -r u m; do
    [[ -n $u ]] || continue
    if [[ ! $u =~ $NM_UUID_ERE ]] || ! case "$m" in auto|dhcp|manual|link-local|shared) true ;; *) false ;; esac; then
      echo "custom-dns-deb: a malformed row in $IPV6_PROFILES is skipped" >&2
      continue
    fi
    if now="$(nmcli -g ipv6.method con show "$u" 2>/dev/null)"; then st=0; else st=$?; fi
    if (( st == 10 )); then
      echo "custom-dns-deb: NetworkManager profile $u no longer exists; nothing to give back"
      continue
    elif (( st != 0 )); then
      echo "custom-dns-deb: could not read NetworkManager profile $u (nmcli exit $st; is NetworkManager running?)" >&2
      rc=1; continue
    fi
    [[ $now != "$m" ]] || continue
    if [[ $now != disabled ]]; then
      echo "custom-dns-deb: NetworkManager profile $u changed since the record (ipv6.method $now); leaving it as it is" >&2
      continue
    fi
    if nmcli con mod "$u" ipv6.method "$m" >/dev/null 2>&1; then
      echo "custom-dns-deb: NetworkManager profile $u has ipv6.method $m again"
      while IFS= read -r d; do
        nmcli dev reapply "$d" >/dev/null 2>&1 || echo "custom-dns-deb: could not reapply $d; reconnect it to use IPv6 again" >&2
      done < <(nm_profile_devices "$u")
    else
      echo "custom-dns-deb: could not set NetworkManager profile $u back to ipv6.method $m" >&2
      rc=1
    fi
  done < <(awk -F '\t' '!seen[$1]++' "$IPV6_PROFILES")
  return "$rc"
}

cmd_pin() {
  # 1) systemd-resolved stops managing /etc/resolv.conf.
  if systemctl is-active --quiet systemd-resolved; then
    systemctl stop systemd-resolved
  fi
  if systemctl is-enabled --quiet systemd-resolved; then
    systemctl disable systemd-resolved
  fi
  # 2) /etc/resolv.conf is a plain file pointing at 127.0.0.1. A symlink (eg.
  # to stub-resolv.conf) or a missing file is replaced; a differing file is
  # backed up first.
  if [[ -L $RESOLV || ! -f $RESOLV ]]; then
    rm -f "$RESOLV"
    printf '%s\n' "$PIN" >"$RESOLV"
  elif ! pinned || ! grep -Fxq "$PIN" "$RESOLV"; then
    # The record already holds the state before nice-dns; without one (a pin
    # outside an install) keep a dated backup as before.
    receipt_ok || cp "$RESOLV" "$RESOLV".bak."$(date +%Y%m%d_%H%M%S)"
    printf '%s\n' "$PIN" >"$RESOLV"
  fi
  chmod 644 "$RESOLV"
  echo "System-wide DNS now points to 127.0.0.1:53"
}

cmd_check() {
  # Before a record exists nothing is ours yet: any state is the owner's.
  receipt_ok || return 0
  if ! pinned; then
    echo "custom-dns-deb: /etc/resolv.conf was changed by another owner after nice-dns pinned it:" >&2
    sed 's/^/  /' "$RESOLV" >&2 2>/dev/null || echo "  (missing)" >&2
    echo "custom-dns-deb: not changing it. Run the uninstall to restore the recorded state, then install again." >&2
    return 3
  fi
}

cmd_snapshot() {
  local tmp origin k v legacy_mark=0 f
  if receipt_ok; then
    echo "custom-dns-deb: keeping the existing record ($(receipt_get created))"
    return 0
  fi
  [[ -L $R/var/lib/nice-dns ]] && { echo "custom-dns-deb: $R/var/lib/nice-dns is a symlink; refusing" >&2; return 1; }
  install -d -m 700 "$RECEIPT_DIR"
  [[ -L $RECEIPT_DIR ]] && { echo "custom-dns-deb: $RECEIPT_DIR is a symlink; refusing" >&2; return 1; }
  for f in "${OWNED_FILES[@]}"; do [[ -e $f ]] && legacy_mark=1; done
  # An install from before records: the pin is already there, so the state
  # before nice-dns is unknown.
  if (( legacy_mark )) && pinned; then origin=legacy; else origin=fresh; fi
  if [[ $origin == legacy ]] && ! nm_answers; then
    echo "custom-dns-deb: NetworkManager did not answer, so the profiles an older installer pinned cannot be recorded; start it and run the install again" >&2
    return 1
  fi
  tmp="$(mktemp "$RECEIPT_DIR/.receipt.XXXXXX")"
  {
    printf 'schema\t%s\n' "$SCHEMA"
    printf 'origin\t%s\n' "$origin"
    printf 'created\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ -L $RESOLV ]]; then
      printf 'resolv\tsymlink\t%s\n' "$(readlink "$RESOLV")"
    elif [[ -f $RESOLV ]]; then
      printf 'resolv\tfile\t%s\n' "$(stat -c %a "$RESOLV")"
    else
      printf 'resolv\tmissing\t-\n'
    fi
    printf 'resolved_enabled\t%s\n' "$(unit_state is-enabled systemd-resolved.service)"
    printf 'resolved_active\t%s\n' "$(unit_state is-active systemd-resolved.service)"
    for k in $SYSCTL_KEYS; do
      v="$(sysctl -n "$k" 2>/dev/null || echo -)"
      printf 'sysctl\t%s\t%s\n' "$k" "$v"
    done
    if [[ $origin == legacy ]]; then
      nm_pinned_profiles | while IFS= read -r v; do printf 'nm_pin\t%s\n' "$v"; done
    fi
  } >"$tmp"
  if [[ -f $RESOLV && ! -L $RESOLV ]]; then
    cp "$RESOLV" "$RECEIPT_DIR/resolv.conf.orig"
    chmod 600 "$RECEIPT_DIR/resolv.conf.orig"
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$RECEIPT"
  echo "custom-dns-deb: recorded the resolver state ($origin)"
}

# fail_restore <why>: the resolv.conf step failed; nothing else has changed.
fail_restore() {
  rm -f "${RESOLV:?}.nice-dns-new"
  echo "custom-dns-deb: $1. Nothing else was changed: /etc/resolv.conf stays pinned to 127.0.0.1 and the record is kept; run the restore again once that is fixed." >&2
  exit 1
}

cmd_restore() {
  local origin kind target mode k v f nm=0 new="$RESOLV.nice-dns-new"
  if ! receipt_ok; then
    echo "custom-dns-deb: no record of the resolver state before nice-dns; treating it as an install from before records" >&2
    origin=legacy kind=unknown
  else
    origin="$(receipt_get origin)"
    kind="$(awk -F '\t' '$1 == "resolv" { print $2; exit }' "$RECEIPT")"
  fi

  # 1) /etc/resolv.conf first, while dns=none and the dispatcher hook still
  #    keep NetworkManager off it. It is replaced whole (a new file or link
  #    renamed over it), and a failure stops the restore with nothing else
  #    changed: the host stays coherently pinned and the record stays.
  if ! pinned; then
    echo "custom-dns-deb: /etc/resolv.conf was changed by another owner; leaving it as it is" >&2
  elif [[ $origin == fresh ]]; then
    case "$kind" in
      symlink)
        target="$(awk -F '\t' '$1 == "resolv" { print $3; exit }' "$RECEIPT")"
        [[ -n $target ]] || fail_restore "the record names no resolv.conf symlink target"
        rm -f "$new"
        { ln -s "$target" "$new" && mv -Tf "$new" "$RESOLV"; } || fail_restore "could not put the /etc/resolv.conf symlink back" ;;
      file)
        mode="$(awk -F '\t' '$1 == "resolv" { print $3; exit }' "$RECEIPT")"
        [[ -f $RECEIPT_DIR/resolv.conf.orig && ! -L $RECEIPT_DIR/resolv.conf.orig ]] \
          || fail_restore "the recorded copy of /etc/resolv.conf is missing"
        { cp "$RECEIPT_DIR/resolv.conf.orig" "$new" && chmod "${mode:-644}" "$new" && mv -f "$new" "$RESOLV"; } \
          || fail_restore "could not write /etc/resolv.conf" ;;
      missing) rm -f "$RESOLV" || fail_restore "could not remove /etc/resolv.conf" ;;
      *) fail_restore "the record's resolv.conf row is malformed" ;;
    esac
  elif [[ "$(unit_state is-enabled systemd-resolved.service)" != absent ]]; then
    # State before nice-dns unknown: the distribution default.
    rm -f "$new"
    { ln -s ../run/systemd/resolve/stub-resolv.conf "$new" && mv -Tf "$new" "$RESOLV"; } \
      || fail_restore "could not link /etc/resolv.conf to the systemd-resolved stub"
  else
    echo "custom-dns-deb: no record and no systemd-resolved: /etc/resolv.conf still points at 127.0.0.1; set a resolver by hand" >&2
  fi

  # 2) The pin's own machinery, so nothing writes 127.0.0.1 back.
  systemctl disable --now custom-dns-deb.service >/dev/null 2>&1 || true
  for f in "${OWNED_FILES[@]}"; do
    if [[ -e $f || -L $f ]]; then
      case "$f" in *NetworkManager*) nm=1 ;; esac
      rm -f "${f:?}"
    fi
  done
  rmdir "$R/etc/systemd/system/NetworkManager-wait-online.service.d" 2>/dev/null || true
  systemctl daemon-reload >/dev/null 2>&1 || true

  # 3) The rest of the recorded state.
  if [[ $origin == fresh ]]; then
    for k in $SYSCTL_KEYS; do
      v="$(awk -F '\t' -v k="$k" '$1 == "sysctl" && $2 == k { print $3; exit }' "$RECEIPT")"
      [[ -n $v && $v != - ]] && sysctl -q -w "$k=$v" >/dev/null 2>&1 || true
    done
    case "$(receipt_get resolved_enabled)" in
      enabled|enabled-runtime) systemctl enable systemd-resolved >/dev/null 2>&1 || true ;;
    esac
    [[ "$(receipt_get resolved_active)" == active ]] && { systemctl start systemd-resolved >/dev/null 2>&1 || true; }
  else
    sysctl --system >/dev/null 2>&1 || true
    if [[ "$(unit_state is-enabled systemd-resolved.service)" != absent ]]; then
      systemctl enable --now systemd-resolved >/dev/null 2>&1 || true
    fi
  fi
  local v6_ok=1
  restore_ipv6_profiles || v6_ok=0
  restore_ipv6_devices
  # 4) An older installer's profile pins (legacy only): from the record, or,
  #    with no record at all, as found now (an install from before records,
  #    whose pins are nice-dns's by the same signature). Before the
  #    NetworkManager reload, so NetworkManager never takes resolv.conf back
  #    while a stale pin is still in place.
  local pins="" nm_ok=1
  if [[ $origin == legacy ]]; then
    if receipt_ok; then
      pins="$(awk -F '\t' '$1 == "nm_pin" { print $2 }' "$RECEIPT")"
    elif nm_answers; then
      pins="$(nm_pinned_profiles)"
    else
      echo "custom-dns-deb: NetworkManager did not answer; the profiles an older installer pinned cannot be found" >&2
      nm_ok=0
    fi
    # shellcheck disable=SC2086  # UUIDs, one word each
    if [[ -n $pins ]]; then nm_unpin_legacy $pins || nm_ok=0; fi
  fi
  if (( nm )) && systemctl is-active --quiet NetworkManager 2>/dev/null; then
    systemctl reload NetworkManager >/dev/null 2>&1 || true
  fi
  (( v6_ok )) || echo "custom-dns-deb: a NetworkManager profile's IPv6 method was not given back (see above); the record is kept: fix it and run the restore again" >&2
  (( nm_ok )) || echo "custom-dns-deb: a NetworkManager profile still points at 127.0.0.1 (see above); the record is kept: fix it and run the restore again" >&2
  (( v6_ok && nm_ok )) || exit 1
  rm -f "${RECEIPT_DIR:?}/receipt.tsv" "${RECEIPT_DIR:?}/resolv.conf.orig" "${RECEIPT_DIR:?}/ipv6-devices.tsv" "${RECEIPT_DIR:?}/ipv6-profiles.tsv" "${RECEIPT_DIR:?}/ipv6-profiles.run" "${RECEIPT_DIR:?}/ipv6-profiles.prev"
  rmdir "$RECEIPT_DIR" 2>/dev/null || true
  echo "custom-dns-deb: restored the resolver state from before nice-dns ($origin)"
}

cmd_discard() {
  receipt_ok || return 0
  if pinned; then
    echo "custom-dns-deb: the resolver is pinned; use restore, not discard" >&2
    return 1
  fi
  rm -f "${RECEIPT_DIR:?}/receipt.tsv" "${RECEIPT_DIR:?}/resolv.conf.orig" "${RECEIPT_DIR:?}/ipv6-devices.tsv" "${RECEIPT_DIR:?}/ipv6-profiles.tsv" "${RECEIPT_DIR:?}/ipv6-profiles.run" "${RECEIPT_DIR:?}/ipv6-profiles.prev"
  rmdir "$RECEIPT_DIR" 2>/dev/null || true
}

case "${1:-pin}" in
  pin) cmd_pin ;;
  status) if pinned; then echo pinned; else echo unpinned; fi ;;
  discard) cmd_discard ;;
  check) cmd_check ;;
  snapshot) cmd_snapshot ;;
  restore) cmd_restore ;;
  ipv6-profiles) cmd_ipv6_profiles ;;
  ipv6-profiles-undo) cmd_ipv6_profiles_undo ;;
  ipv6-profiles-done) cmd_ipv6_profiles_done ;;
  *) echo "usage: custom-dns-deb [pin|check|snapshot|restore|status|discard|ipv6-profiles|ipv6-profiles-undo|ipv6-profiles-done]" >&2; exit 2 ;;
esac
