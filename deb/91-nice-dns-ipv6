#!/usr/bin/env bash
# nice-dns NetworkManager dispatcher hook (Linux, root; BL-050, WF-DNS-001).
# Installed as /etc/NetworkManager/dispatcher.d/91-nice-dns-ipv6 and its
# pre-up.d copy; owned by deb/custom-dns-deb (OWNED_FILES).
#
# NetworkManager activating a profile with ipv6.method auto turns the device's
# disable_ipv6 back to 0, after systemd-sysctl set it to 1 through
# net.ipv6.conf.default (measured 2026-10-12: 1 before NetworkManager, 0
# within its activation). On pre-up and up this sets the device's switch to 1
# again (and on reapply, which reruns IP configuration). It writes only that
# switch: no connection profile is changed, and the address family stays
# (never the kernel's ipv6.disable=1, which left Mullvad blocked on every
# boot, 2026-07-10). Mullvad's tunnel (*-mullvad)
# keeps the default it gets, as does lo (the sysctl.d drop-in owns it). Every
# other device NetworkManager activates loses IPv6, a VPN profile's too: the
# posture is no IPv6 on the host.
#
# Only the installer records, with the `record` action, and only on a host
# where no nice-dns switch is in force yet (lib/install.sh): then each
# device's value is the one from before nice-dns, kept in the root-only
# directory custom-dns-deb keeps its record in, and the uninstall gives it
# back. A value read later is already nice-dns's (writing
# net.ipv6.conf.all sets every existing device; a new device takes default),
# so NetworkManager's events never record; a device with no row gets the
# recorded `all` value at the uninstall, which the kernel applies to every
# device. Recording is best effort.
#
#   91-nice-dns-ipv6 <interface> <action>   (as NetworkManager runs it)
#   91-nice-dns-ipv6 <interface> record     (the installer: record only)
#
# ND_DNS_TEST_ROOT prefixes every path for the fixture tests, honoured only
# when not running as root (as in custom-dns-deb).
set -euo pipefail

R=""
if [[ ${EUID:-$(id -u)} -ne 0 && -n ${ND_DNS_TEST_ROOT:-} ]]; then
  R="$ND_DNS_TEST_ROOT"
fi

iface="${1:-}" action="${2:-}"
case "$action" in pre-up|up|reapply|record) ;; *) exit 0 ;; esac
[[ $iface =~ ^[A-Za-z0-9_.:-]{1,15}$ && $iface != . && $iface != .. ]] || exit 0
case "$iface" in lo|*-mullvad) exit 0 ;; esac

sw="$R/proc/sys/net/ipv6/conf/$iface/disable_ipv6"
[[ -f $sw ]] || exit 0

if [[ $action == record ]]; then
  rec_dir="$R/var/lib/nice-dns/dns-owned"
  rec="$rec_dir/ipv6-devices.tsv"
  [[ -d $rec_dir && ! -L $rec_dir && ! -L $rec ]] || exit 0
  (
    umask 077
    if ! awk -F '\t' -v d="$iface" '$1 == d { f = 1 } END { exit !f }' "$rec" 2>/dev/null; then
      v="$(cat "$sw" 2>/dev/null)" || v=""
      case "$v" in 0|1) printf '%s\t%s\n' "$iface" "$v" >>"$rec" ;; esac
    fi
  ) 2>/dev/null || true
  exit 0
fi
printf '1\n' 2>/dev/null >"$sw" || true
exit 0
